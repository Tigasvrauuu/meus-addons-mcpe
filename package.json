{
  "name": "spider-man-definitive-experience",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "build": "tsc && python3 tools/package.py",
    "test": "tsc && node --import ./tests/register.mjs --test tests/*.test.js",
    "validate": "python3 tools/validate.py",
    "ci": "npm run check && npm test && npm run build && npm run validate"
  },
  "devDependencies": {
    "@minecraft/server": "1.19.0",
    "@minecraft/server-ui": "1.3.0",
    "typescript": "5.7.3"
  }
}
