{
  "format_version": "1.20.0",
  "minecraft:entity": {
    "description": {
      "identifier": "spider:elite",
      "is_spawnable": true,
      "is_summonable": true,
      "is_experimental": false
    },
    "component_groups": {
      "spider:elite_adult": {
        "minecraft:health": { "value": 80, "max": 80 },
        "minecraft:movement": { "value": 0.36 },
        "minecraft:attack": { "damage": 8 },
        "minecraft:collision_box": { "width": 0.8, "height": 1.95 },
        "minecraft:physics": {},
        "minecraft:pushable": { "is_pushable": true, "is_pushable_by_piston": false },
        "minecraft:follow_range": { "value": 40, "max": 80 },
        "minecraft:damage_sensor": { "cause": "fall", "deals_damage": false },
        "minecraft:behavior.melee_attack": { "priority": 4 },
        "minecraft:behavior.ranged_attack": { "priority": 3, "attack_interval_min": 2.0, "attack_interval_max": 3.5, "attack_radius": 12, "charge_shoot_trigger": 2.0 },
        "minecraft:shooter": { "def": "minecraft:snowball" },
        "minecraft:behavior.nearest_attackable_target": { "priority": 2, "must_see": true, "reselect_targets": true, "within_radius": 30, "entity_types": [{ "filters": { "test": "is_family", "subject": "other", "value": "player" }, "max_dist": 50 }] },
        "minecraft:behavior.hurt_by_target": { "priority": 1 },
        "minecraft:behavior.look_at_player": { "priority": 7, "look_distance": 10 },
        "minecraft:behavior.random_stroll": { "priority": 6, "speed_multiplier": 0.9 }
      },
      "spider:webbed": {
        "minecraft:movement": { "value": 0.14 },
        "minecraft:variant": { "value": 2 }
      },
      "spider:enraged": {
        "minecraft:movement": { "value": 0.42 },
        "minecraft:attack": { "damage": 11 }
      }
    },
    "components": {
      "minecraft:type_family": { "family": ["mob", "hostile", "spider_enemy", "elite", "boss"] },
      "minecraft:breathable": { "total_supply": 15, "suffocation_time": 0 },
      "minecraft:nameable": { "allow_name_tag_renaming": true, "always_show": true },
      "minecraft:loot": { "table": "loot_tables/entities/elite.json" },
      "minecraft:experience_reward": { "on_death": "query.last_hit_by_player ? 20 : 0" },
      "minecraft:boss": { "should_darken_sky": false, "hud_range": 32, "name": "Elite Opponent" }
    },
    "events": {
      "minecraft:entity_spawned": { "add": { "component_groups": ["spider:elite_adult"] } },
      "spider:webbed_start": { "add": { "component_groups": ["spider:webbed"] } },
      "spider:webbed_end": { "remove": { "component_groups": ["spider:webbed"] } },
      "spider:enrage": { "add": { "component_groups": ["spider:enraged"] } }
    }
  }
}
